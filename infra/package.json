{
  "name": "nakomis-fleet-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "cdk": "cdk",
    "synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --all",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox --all --require-approval never",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-admin --all --require-approval never",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --all",
    "ci-deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --all --require-approval never --output cdk-deploy.out",
    "ci-deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --all --require-approval never --output cdk-deploy.out"
  },
  "dependencies": {
    "aws-cdk-lib": "2.257.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-iot": "^3.1149.0",
    "@aws-sdk/client-iot-data-plane": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
